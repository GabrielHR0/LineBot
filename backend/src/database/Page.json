          {
            "id": "3",
            "text": "Como funciona?\n",
            "comments": "Ver tutorial do bot",
            "onSelect": {
              "jump": "info:/tutorial"
            }
          }
        ],
        "prepare": {
          "route": "/lineBot/initSuport"
        }
      },
