        "id": "/start",
        "type": "OPTION",
        "text": "Gostaria de iniciar um atendimento conosco?\n\n",
        "list": [
          {
            "id": "1",
            "text": "Sim, vamos lá!\n",
            "comments": "inicializa o atendimento",
            "onSelect": {
              "jump": "option:/main"
            }
          },
          {
            "id": "2",
            "text": "Não por agora, obrigado\n",
            "comments": "Finaliza o atendimento",
            "onSelect": {
              "jump": "info:/exit"
            }
