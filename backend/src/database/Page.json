    "forms": [
      {
        "id": "/enviarData",
        "text": "Informe uma data para o agendamento (até 30 dias a partir de hoje), no formato DD/MM/AAAA. Ex: 15/08/2025.\n\n",
        "type": "FORM",
        "list": [
          {
            "id": "date",
            "text": "Data: \n",
            "format": "text",
            "validates": [
              {
              "route": "/lineBot/validateDate",
              "problem": [
                {
                  "type": "INVALID_DATE_FORMAT",
                  "text": "A data informada não está no formato DD/MM/AAAA.",
                  "action": {
                    "type": "RELAUNCH",
                    "times": 3
                  }
                },
                          {
                  "type": "INVALID_DATE",
                  "text": "A data informada não é válida.",
                  "action": {
                    "type": "RELAUNCH",
                    "times": 3
                  }
                },
                {
                  "type": "OUT_OF_RANGE",
                  "text": "A data deve estar dentro de 30 dias a partir de hoje.",
                  "action": {
                    "type": "RELAUNCH",
                    "times": 3
                  }
                },
                {
                  "type": "PAST_DATE",
                  "text": "A data não pode ser uma data passada.",
                  "action": {
                    "type": "RELAUNCH",
                    "times": 3
                  }
                },
                {
                  "type": "INACTIVE_DAY",
                  "text": "O dia selecionado não aceita agendamentos.",
                  "action": {
                    "type": "RELAUNCH",
                    "times": 3
                  }
                },
                {
                  "type": "FULL_DAY",
                  "text": "O dia selecionado está completamente agendado.",
                  "action": {
                    "type": "RELAUNCH",
                    "times": 3
                  }
                },
                {
                  "type": "DAY_OFF",
                  "text": "O dia selecionado é um dia de folga.",
                  "action": {
                    "type": "RELAUNCH",
                    "times": 3
                  }
                },
                {
                  "type": "NO_APPOINTMENTS",
                  "text": "Não há horários disponíveis para o dia selecionado.",
                  "action": {
                    "type": "RELAUNCH",
                    "times": 3
                  }
                }
              ]
            }]
          }
        ],
        "submit": {
          "jump": "option:/selecionarHorario"
        }
    }
    ],
    "info": [
